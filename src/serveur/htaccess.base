# .htaccess de www.pibes.fr, généré par build.py (bloc fixe : src/serveur/htaccess.base)
# Ne pas modifier dist/.htaccess à la main : il est réécrit à chaque construction.

# ---------- Passage en https et en www (redirection 301) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------- Fichiers privés du formulaire (form-handler.php) ----------
# submissions.csv contient les messages reçus : jamais lisible depuis le web.
<FilesMatch "\.(csv|log|sql|bak)$">
  Require all denied
</FilesMatch>

# ---------- Page d'erreur et listes de dossiers ----------
ErrorDocument 404 /404.html
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# ---------- Types de fichiers ----------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- Cache : 1 an pour assets/ (adresses versionnées par ?v=), 1 heure pour le HTML ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
</IfModule>

# ---------- En-têtes de sécurité ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
